<Window x:Class="WANativeLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WA Native Lite - Demo" Width="1120" Height="720"
        MinWidth="740" MinHeight="480" WindowStartupLocation="CenterScreen"
        Background="#111B21" Foreground="#E9EDEF">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#202C33"/>
      <Setter Property="Foreground" Value="#E9EDEF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2A3942"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="305"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#111B21" BorderBrush="#34444D" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="WA Native Lite" FontSize="24" FontWeight="Bold" Margin="20,22,20,3"/>
          <TextBlock Text="OFFLINE DEMO • No WhatsApp connection" Foreground="#8CA5B0" FontSize="11" Margin="20,0,12,18"/>
          <TextBox x:Name="SearchBox" Margin="14,0,14,14" TextChanged="SearchBox_TextChanged" ToolTip="Search demo chats"/>
        </StackPanel>
        <ListBox x:Name="ChatsList" BorderThickness="0" Background="Transparent"
                 Foreground="White" SelectionChanged="ChatsList_SelectionChanged"
                 DisplayMemberPath="Name">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="18,15"/>
              <Setter Property="Background" Value="#111B21"/>
              <Setter Property="Foreground" Value="#E9EDEF"/>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#2A3942"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Background="#0B141A">
      <Grid.RowDefinitions>
        <RowDefinition Height="76"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="74"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#202C33">
        <StackPanel Margin="22,13">
          <TextBlock x:Name="ChatTitle" Text="Select a conversation" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="Local preview only" Foreground="#90A8B3" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="MessagePanel" Margin="22,20"/>
      </ScrollViewer>
      <Grid Grid.Row="2" Background="#202C33">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Attach" Margin="12" Click="Attach_Click"/>
        <TextBox x:Name="MessageInput" Grid.Column="1" VerticalContentAlignment="Center"
                 Margin="0,13" KeyDown="MessageInput_KeyDown" ToolTip="Type a demo message"/>
        <Button Grid.Column="2" Content="Send" Margin="12" Click="Send_Click"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
