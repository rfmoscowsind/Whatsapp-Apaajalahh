<Window x:Class="WANativeLite.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Apaajalahh | Unofficial Native Messenger" Width="1150" Height="760"
 MinWidth="820" MinHeight="540" Background="#0B141A" Foreground="#E9EDEF"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#202C33"/>
  <SolidColorBrush x:Key="Line" Color="#33414B"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#263943"/>
   <Setter Property="Foreground" Value="#E9EDEF"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="13,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="3"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#2A3942"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#42525E"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,11"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="330"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#111B21" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Grid Margin="17,16,12,9">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Apaajalahh" FontSize="25" FontWeight="Bold" Foreground="#E9EDEF"/>
       <TextBlock Text="Native desktop · Unofficial client" FontSize="11" Foreground="#8DA7B5" Margin="0,3,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="+ Chat" Click="NewChat_Click" VerticalAlignment="Center" ToolTip="Start a chat with a phone number"/>
     </Grid>
     <TextBox x:Name="SearchBox" Margin="14,9,14,13" ToolTip="Search locally cached chats" TextChanged="SearchBox_TextChanged"/>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="0,0,0,7"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,13">
     <TextBlock x:Name="StatusText" Text="Starting local engine..." TextWrapping="Wrap" Foreground="#8DA7B5" FontSize="12" Margin="4,4,4,6"/>
     <WrapPanel>
      <Button x:Name="LoginButton" Content="Link phone (QR)" Click="Login_Click"/>
      <Button x:Name="LogoutButton" Content="Logout" Click="Logout_Click" Visibility="Collapsed"/>
     </WrapPanel>
     <TextBlock Text="Test account recommended • Cache stored only on this PC" FontSize="10" Foreground="#718894" TextWrapping="Wrap" Margin="4,8,0,0"/>
    </StackPanel>
    <ListBox x:Name="ChatsList" Background="Transparent" BorderThickness="0" Foreground="White"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingStackPanel.IsVirtualizing="True"
             VirtualizingStackPanel.VirtualizationMode="Recycling"
             SelectionChanged="ChatsList_SelectionChanged">
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
       <Setter Property="Padding" Value="0"/>
       <Setter Property="BorderThickness" Value="0"/>
       <Setter Property="Background" Value="#111B21"/>
       <Setter Property="Foreground" Value="White"/>
       <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="#273640"/>
        </Trigger>
       </Style.Triggers>
      </Style>
     </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="17,13,12,13">
        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F0F5F7"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#A0B3BF"
                   TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
       </StackPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="73"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="83"/>
   </Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
    <StackPanel Margin="23,13">
     <TextBlock x:Name="ChatTitle" Text="Choose a conversation" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock x:Name="ChatSubtitle" Text="Stored conversations open even without a connection" Foreground="#A0B3BF" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Border>
   <ListBox x:Name="MessagesList" Grid.Row="1" Background="#0B141A" Foreground="White"
            BorderThickness="0" Padding="18,16"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border Background="{Binding BubbleBrush}" CornerRadius="10"
              MaxWidth="590" Padding="13,9"
              HorizontalAlignment="{Binding Placement}">
       <StackPanel>
        <TextBlock Text="{Binding SenderLabel}" FontSize="10" Foreground="#96BCB3" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#E9EDEF" FontSize="14"/>
        <Button Content="{Binding DownloadLabel}" Visibility="{Binding DownloadVisibility}"
                Tag="{Binding}" Click="Download_Click" HorizontalAlignment="Left" Margin="0,7,0,0"/>
        <TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right" FontSize="10"
                   Foreground="#9CB1BB" Margin="30,7,0,0"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
    <Grid Margin="12,11">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <Button Grid.Column="0" Content="Attach" Click="Attach_Click" ToolTip="Send a document (64 MiB max)"/>
     <TextBox x:Name="MessageInput" Grid.Column="1" Margin="8,3" VerticalContentAlignment="Center"
              AcceptsReturn="True" TextWrapping="Wrap" MaxLines="3"
              KeyDown="MessageInput_KeyDown" ToolTip="Enter to send, Shift+Enter for newline"/>
     <Button Grid.Column="2" Content="Send ↗" Click="Send_Click"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
